rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // PLAYER PROFILES
    // ============================================================
    match /players/{playerId} {
      // Jeder authentifizierte User kann alle Player-Profile lesen
      allow read: if request.auth != null;

      // Nur eigenes Profil bearbeiten
      allow create, update: if request.auth != null && request.auth.uid == playerId;
      allow delete: if false; // Keine Löschung erlaubt
    }

    // ============================================================
    // LEGACY: USERS (falls noch verwendet)
    // ============================================================
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ============================================================
    // ALLIANCES (noch nicht implementiert, daher read-only)
    // ============================================================
    match /alliances/{id} {
      allow read: if true;
      allow write: if false; // TODO: Implementieren wenn Alliance-System fertig
    }

    // ============================================================
    // WORLD DATA
    // ============================================================
    match /worlds/{worldId} {
      // Jeder kann World-Metadata lesen
      allow read: if true;
      allow write: if false; // Nur Server/Admin darf schreiben

      // Regions: Alle können lesen, keiner schreibt (Server-managed)
      match /regions/{regionId} {
        allow read: if true;
        allow write: if false;

        // Tiles: Alle können lesen, Schreibzugriff für Settlement-Placement
        match /tiles/{tileId} {
          allow read: if true;

          // Schreibzugriff nur für authentifizierte User
          // TODO: Validierung dass User nur eigene Settlements platziert
          allow write: if request.auth != null;
        }
      }

      // Units: Alle lesen, nur Owner kann eigene Units modifizieren
      match /units/{unitId} {
        allow read: if true;

        // Nur eigene Units erstellen/modifizieren
        allow create: if request.auth != null
                      && request.resource.data.ownerId == request.auth.uid;

        allow update, delete: if request.auth != null
                               && resource.data.ownerId == request.auth.uid;
      }

      // Convoys: Nur eigene Convoys lesen/erstellen
      match /convoys/{convoyId} {
        allow read: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || !exists(/databases/$(database)/documents/worlds/$(worldId)/convoys/$(convoyId)));

        allow create: if request.auth != null
                      && request.resource.data.ownerId == request.auth.uid;

        // Updates nur durch Cloud Functions (Backend)
        allow update, delete: if false;
      }
    }
  }
}
