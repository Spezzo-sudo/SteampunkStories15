# Supabase Configuration
# Kopiere diese Datei zu `.env.local` und füge deine Supabase-Credentials ein
# WICHTIG: .env.local ist in .gitignore und wird NICHT ins Git committed!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: World ID für Multiplayer
VITE_WORLD_ID=playtest-world
