# Firebase Configuration
# Kopiere diese Datei zu `.env` und füge deine Firebase-Credentials ein
# WICHTIG: .env ist in .gitignore und wird NICHT ins Git committed!

VITE_FIREBASE_API_KEY=deine_api_key_hier
VITE_FIREBASE_AUTH_DOMAIN=dein-projekt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dein-projekt-id
VITE_FIREBASE_STORAGE_BUCKET=dein-projekt.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Optional: World ID für Multiplayer
VITE_WORLD_ID=playtest-world
